#Tokenized Key (currently unused by app.js)
JWT_SECRET=

#Session cookie signing secret — set this so logins survive a server restart.
#If unset, a random secret is generated on every boot and all sessions are invalidated.
SESSION_SECRET=

#Comma-separated list of allowed frontend origins for CORS, e.g. https://app.example.com
#If unset, CORS reflects the request origin (permissive; current default behavior).
CORS_ORIGIN=

#Mobile Application Database
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_DATABASE=

#Website Database
WEB_DB_HOST=
WEB_DB_USER=
WEB_DB_PASSWORD=
WEB_DB_DATABASE=

#SMTP (password reset / OTP emails) - currently sent via Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
